;;; 練習問題1.5
;;; 適用順序評価か正規順序評価かを判別するBenのテスト
;;;
;;; 適用順序(Gaucheなど実際のScheme):
;;;   手続き適用の前に引数をすべて評価する。
;;;   (test 0 (p)) は第2引数(p)を評価しようとし、(p)の本体が(p)なので
;;;   自分自身を呼び続けて無限ループ。(= x 0)には決して到達しない。
;;;   => 返ってこない(ハングする)
;;;
;;; 正規順序:
;;;   引数を評価せず、必要になるまで式のまま展開する。
;;;     (if (= 0 0) 0 (p))
;;;   ifは特殊形式なので述語を先に評価し、真なので結果式0だけを評価する。
;;;   代替式の(p)は一度も評価されない。
;;;   => 0 が返る
;;; 遅延評価は正規順序 + メモ化

;; 引数0個の手続き。本体が自分自身の呼び出しなので、評価すると停止しない
(define (p) (p))

(define (test x y)
  (if (= x 0)
      0
      y))

(define (main args)
  ;; Gaucheでは無限ループする
  ;; (print (test 0 (p)))

  ;; (p)を渡さなければ普通に動く。testの定義自体は正しいことの確認
  (print (test 0 99)) ; => 0   xが0なので結果式0
  (print (test 1 99)) ; => 99  xが0でないので代替式y
  0)
